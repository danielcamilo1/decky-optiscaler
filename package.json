{
  "name": "decky-optiscaler",
  "version": "0.0.4",
  "description": "Manage OptiScaler per game from the Steam Deck UI, without the in-game overlay",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "optiscaler",
    "framegen",
    "fsr",
    "upscaling"
  ],
  "author": "kmilovm91722",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielcamilo1/decky-optiscaler.git"
  },
  "bugs": {
    "url": "https://github.com/danielcamilo1/decky-optiscaler/issues"
  },
  "homepage": "https://github.com/danielcamilo1/decky-optiscaler#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "supportedArchitectures": {
      "cpu": [
        "arm64",
        "x64"
      ],
      "libc": [
        "glibc",
        "musl"
      ],
      "os": [
        "darwin",
        "linux"
      ]
    },
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
